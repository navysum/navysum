{
  "name": "notion-for-obsidian",
  "version": "1.0.0",
  "description": "Notion-style databases, views, charts and slash commands for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node tests/run.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "notion",
    "database",
    "kanban"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.2"
  }
}
